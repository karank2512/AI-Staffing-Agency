    "ai": "^5.0.259",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
