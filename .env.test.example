# Copy to .env.test for `npm test`. Tests always run in Simulated mode against a dedicated database:
#   createdb ai_staffing_agency_test
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/ai_staffing_agency_test?schema=public&options=-c%20TimeZone%3DUTC"
AUTH_SECRET="test-secret-not-used-in-production"
AUTH_TRUST_HOST=true
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""
EXECUTOR_DISABLED=true
