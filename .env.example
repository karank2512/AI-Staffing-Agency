# ── Required ────────────────────────────────────────────────────────────────
# Local Postgres (Homebrew): createdb ai_staffing_agency
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/ai_staffing_agency?schema=public&options=-c%20TimeZone%3DUTC"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# openssl rand -base64 32  (AES-256-GCM key for the credentials vault)
CREDENTIAL_ENCRYPTION_KEY=""

# ── Optional: model providers ───────────────────────────────────────────────
# With no keys set the app runs in clearly-badged "Simulated mode" using a deterministic mock provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Override which model serves each tier: "<provider>:<model-id>"
# MODEL_TIER_FAST=anthropic:claude-haiku-4-5
# MODEL_TIER_STANDARD=anthropic:claude-sonnet-5
# MODEL_TIER_REASONING=anthropic:claude-opus-5

# Force the mock provider even when keys exist (useful for demos/tests)
# FORCE_SIMULATED=true

# ── Optional: tools ─────────────────────────────────────────────────────────
# Real web search (https://tavily.com). Without it, web_search returns realistic simulated results.
TAVILY_API_KEY=

# ── Optional: runtime ───────────────────────────────────────────────────────
# EXECUTOR_DISABLED=true        # don't start the in-process executor/scheduler
# EXECUTOR_POLL_MS=1000
# EXECUTOR_CONCURRENCY=2
# USAGE_MARGIN_MULTIPLIER=1.4   # billable = cost × multiplier
